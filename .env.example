# Copy to .env and fill in. .env is gitignored; never commit real values.
#   POSTGRES_PASSWORD  Postgres / Odoo master password for the local stack
#   ADMIN_PASSWORD     first-boot password of the MCP Admin console
#   MCP_AUTH_TOKEN     first-boot MCP proxy token; leave empty and rotate in the GUI
#   JWT_SECRET         signs the console session cookies
#
# Generate values with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
#   python3 -c 'import secrets; print(secrets.token_hex(10))'   # MCP_AUTH_TOKEN
POSTGRES_PASSWORD=
ADMIN_PASSWORD=
MCP_AUTH_TOKEN=
JWT_SECRET=
