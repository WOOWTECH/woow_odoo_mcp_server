# Patterns to ignore when building Helm packages.
# files/ must stay in: templates read files/patches/*.py with .Files.Glob.
.DS_Store
.git/
.gitignore
.github/
.helmignore
*.tgz
*.bak
*.tmp
*.swp
.idea/
.vscode/
README*.md
examples/
# Instance values live at the repo root (deploy/woow-k3s/<tenant>.yaml), outside
# the chart directory, so they are never packaged in the first place.
